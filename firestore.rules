rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function staff() {
      return signedIn()
        && request.auth.token.email != null
        && (
          request.auth.token.email == "tasviaacademy@gmail.com"
          || exists(/databases/$(database)/documents/Staff/$(request.auth.token.email))
        );
    }
    function admin() {
      return signedIn()
        && request.auth.token.email != null
        && (
          request.auth.token.email == "tasviaacademy@gmail.com"
          || (
            exists(/databases/$(database)/documents/Staff/$(request.auth.token.email))
            && get(/databases/$(database)/documents/Staff/$(request.auth.token.email)).data.role == "admin"
          )
        );
    }

    // Staff accounts are controlled from the Staff collection.
    // A staff member can read their own account; only admins can manage staff.
    match /Staff/{email} {
      // A signed-in user may read only their own Staff document.
      // Do not call staff() here because staff() reads this same document.
      allow get: if signedIn()
        && request.auth.token.email != null
        && request.auth.token.email.lower() == email.lower();

      // Staff login may need to locate an existing staff record when the
      // document ID is not the user's email (legacy/auto-ID records).
      // Listing is restricted to authenticated Firebase users and the client
      // only requests a single matching email record.
      allow list: if signedIn() && request.query.limit <= 1;
      allow create, update, delete: if admin();
    }

    // Main academic/operational data is available only to authenticated staff.
    match /students/{id} {
      allow read, write: if staff();
    }

    // Monthly fee records and payment history are managed by staff.
    // Required for the Staff Portal "Record payment" action.
    match /fees/{id} {
      allow read, write: if staff();
    }

    // Permanent fee payment ledger. Individual payment records are never dependent on the mutable fee summary document.
    match /paymentRecords/{id} {
      allow read, write: if staff();
    }

    match /tests/{id} {
      allow read, write: if staff();
    }

    match /attendance/{id} {
      allow read, write: if staff();
    }

    match /diary/{id} {
      allow read, write: if staff();
    }

    match /staffattendance/{id} {
      allow read, write: if staff();
    }

    match /teachers/{id} {
      allow read, write: if admin();
    }

    match /salaries/{id} {
      allow read, write: if admin();
    }

    match /expenses/{id} {
      allow read, write: if admin();
    }

    // Investment ledger. Any authenticated TASVIA staff member may create a record,
    // but the creator identity must come from Firebase Auth and is immutable to staff.
    // Only admins can edit or delete an existing investment record.
    match /investmentRecords/{id} {
      allow read: if staff();
      allow create: if staff()
        && request.resource.data.addedByUid == request.auth.uid
        && request.resource.data.addedByEmail == request.auth.token.email
        && (
          request.auth.token.email == "tasviaacademy@gmail.com"
          || (
            exists(/databases/$(database)/documents/Staff/$(request.auth.token.email))
            && request.resource.data.addedByName
              == get(/databases/$(database)/documents/Staff/$(request.auth.token.email)).data.name
          )
        );
      allow update, delete: if admin();
    }

    match /info/centre {
      allow read, write: if staff();
    }

    match /photos/{id} {
      allow read, write: if staff();
    }

    // Parent links are bearer links: parents can read only the single
    // parentView document addressed by their private code. They cannot list
    // the collection or write parent records.
    match /parentView/{code} {
      allow get: if true;
      allow list: if false;
      allow create, update, delete: if staff();
    }

    // Parents can persist homework completion for their own bearer-code portal.
    // The code must already exist as a parentView document; collection listing is never allowed.
    match /homeworkCompletions/{code} {
      allow get: if
        code is string
        && exists(/databases/$(database)/documents/parentView/$(code));
      allow list: if false;
      allow create, update: if
        !signedIn()
        && request.resource.data.code == code
        && request.resource.data.completed is map
        && request.resource.data.completed.size() <= 200
        && exists(/databases/$(database)/documents/parentView/$(code));
      allow delete: if staff();
    }

    // The parent portal stores a small daily GK snapshot for backup.
    // Parents may create/update a backup only when the supplied code maps to
    // an existing parentView document. Staff retain full archive access.
    match /gkBackup/{backupId} {
      allow get, list: if staff();

      allow create, update: if
        staff()
        || (
          !signedIn()
          && request.resource.data.code is string
          && request.resource.data.date is string
          && request.resource.data.questions is list
          && request.resource.data.questions.size() <= 5
          && backupId == request.resource.data.code + "_" + request.resource.data.date
          && exists(/databases/$(database)/documents/parentView/$(request.resource.data.code))
        );

      allow delete: if staff();
    }

    // Explicit deny-by-default for every other collection/document.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}